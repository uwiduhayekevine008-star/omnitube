# Keep this file out of production deployments. Use a secret manager.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_WORKER_ID=omnitube-media-worker-1
MEDIA_WORKER_POLL_MS=3000
MEDIA_WORKER_LEASE_MS=900000
MEDIA_WORKER_MAX_ATTEMPTS=4
MEDIA_WORKER_MAX_SOURCE_BYTES=2147483648
MEDIA_WORKER_MAX_DURATION_SECONDS=21600
MEDIA_WORKER_TEMP_DIR=/tmp/omnitube-media
